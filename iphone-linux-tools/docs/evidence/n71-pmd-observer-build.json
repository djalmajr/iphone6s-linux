      "parameters": [
        "run:Explicitly run one N71 clock/reset diagnostic at probe (bool)",
        "enumerate:Also train WLAN1 and read identity, without DMA or radio (bool)",
        "config_inventory:Read bounded endpoint config after enumeration; no BAR sizing (bool)",
        "host_scan:Temporarily scan with PCI core; size/restore BARs, no binding or DMA (bool)",
        "scan_pme_disable:Opt-in endpoint PME_ENABLE disable/restore for host_scan; no W1C (bool)",
        "scan_hold:Keep the PME host scan and its owners until action=cleanup; no bind or DMA (bool)",
        "msi_parent:Associate the private MSI parent before the held scan; allocation requires a separate action (bool)",
        "iommu_parent:Associate the retained DART provider before the held MSI scan; no driver or DMA (bool)",
        "driver_runtime:Permit explicit brcmfmac prepare/publish/release actions; probe never loads firmware (bool)",
        "dma_observe:Permit bounded read-only DMA observations while brcmfmac is bound (bool)",
        "dma_iova:Explicit 32-bit IOVA to query; reading it does not initiate DMA (ullong)",
        "bar_sizing:Size/restore endpoint BARs directly; no PCI devices, MMIO or DMA (bool)",
        "chip_id:Size BAR0 and read ChipCommon ID once; temporary route, no DMA or radio (bool)",
        "dart_observe:Read two stable DART snapshots; no provider, DART writes, DMA or IRQ (bool)",
        "dart_cycle:Test temporary DART provider and restore tables; no DMA attachment (bool)",
        "dma_observation:Two bounded DMA snapshots with validity and boottime; not hardware translation proof",
        "action:assign, dart-hold/release, msi-hold/release, driver-prepare/publish/release, cleanup operate on the retained session; no rescan",
        "status:Inspect retained ownership and cleanup errors before normal unload",
        "held:Read live bus ownership; distinct from pending restoration",
        "resources:Read assignment and pending ownership; a removed bus is never assigned",
        "dart:Read DART ownership and recovery progress independently of PCI resources",
        "msi:Read MSI association ownership and pending session cleanup; not IRQ delivery proof",
        "msi_allocation:Read allocation ownership and last validation; no new IO or IRQ delivery proof",
        "iommu:Read OF/core DART association and pending cleanup; not DMA translation proof",
        "driver_runtime_status:Read driver runtime ownership and errors; publication is not firmware or radio readiness"
      ],
      "elf64_aarch64_relocatable": true
    },
