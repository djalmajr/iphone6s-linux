-	regmap_update_bits(ps->regmap, ps->offset, APPLE_PMGR_FLAGS | APPLE_PMGR_RESET,
-			   APPLE_PMGR_RESET);
+	ret = regmap_update_bits(ps->regmap, ps->offset,
+				 APPLE_PMGR_FLAGS | APPLE_PMGR_DEV_DISABLE,
+				 APPLE_PMGR_DEV_DISABLE);
+	if (!ret)
+		ret = regmap_update_bits(ps->regmap, ps->offset,
